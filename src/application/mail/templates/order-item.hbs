<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{title}}</title>
  </head>
  <body style='margin:0;font-family: Arial, Helvetica, sans-serif;'>
    <table style='border:0;width:100%'>
      <tr style='background:#eeeeee'>
        <td
          style='padding:20px;color:#808080;text-align:center;font-size:40px;font-weight:600'
        >
          {{app_name}}
        </td>
      </tr>
      <tr>
        <td
          style='padding:20px;color:black;font-size:32px;font-weight:100;text-align:center'
        >
          {{item_name}}<br />
        </td>
      </tr>
      <tr>
        <td style='text-align:center'>
          <img src='{{qrcode_path}}' />
        </td>
      </tr>
      <tr>
        <td style='text-align:center'>
          <p>voucher code: {{item_code}}</p>
        </td>
      </tr>
      <tr>
        <td style='text-align:center'>
          <p>Expired time: {{expired_time}}</p>
        </td>
      </tr>
    </table>
  </body>
</html>